# NVIDIA (NIM / LLM)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# Duffel (Flight Offers)
DUFFEL_ACCESS_TOKEN=your-duffel-access-token
DUFFEL_BASE_URL=https://api.duffel.com

# AviationStack (Flight Schedules)
AVIATIONSTACK_API_KEY=your-aviationstack-api-key
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# Open-Meteo (Weather)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenStreetMap Ecosystem (Places / Geocoding / Routing)
NOMINATIM_USER_AGENT=TripPilot/1.0 (your-email@example.com)
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

# Application
PORT=3000
NODE_ENV=development